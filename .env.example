# Clone AI Employee OS - Environment Configuration

# Server & Node
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Security & Secrets
JWT_SECRET=super-secret-jwt-token-key-change-in-production-min-32-chars
COOKIE_SECRET=super-secret-cookie-signing-key-32-chars-long
SESSION_SECRET=super-secret-session-encryption-key-for-clone

# Database (MongoDB)
DATABASE_URL=mongodb://clone_admin:clone_pass@localhost:27017/clone_os?authSource=admin

# Redis Queue & Rate Limiting
REDIS_URL=redis://localhost:6379

# Encryption Key for Integration OAuth Tokens (32 bytes AES-256-GCM)
INTEGRATION_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM Execution Configuration
OPENAI_API_KEY=mock-key-for-local-demo
ANTHROPIC_API_KEY=mock-key-for-local-demo
MISTRAL_API_KEY=mock-key-for-local-demo
HUGGINGFACE_API_KEY=hf_your_huggingface_token
DEFAULT_LLM_MODEL=gpt-4o
BARK_MODEL_ID=suno/bark
BARK_VOICE_PRESET=v2/en_speaker_6

# External Integration OAuth Credentials (Optional / Mock default)

#GITHUB
# Authorization callback URL on the GitHub OAuth App must be:
# http://localhost:4000/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

#SLACK
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

#GOOGLE
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

#LINEAR
LINEAR_CLIENT_ID=mock_linear_client_id
LINEAR_CLIENT_SECRET=mock_linear_client_secret

#NOTION
NOTION_CLIENT_ID=mock_notion_client_id
NOTION_CLIENT_SECRET=mock_notion_client_secret

# Rate Limits
RATE_LIMIT_GENERAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_TOOLS_PER_MIN=100
